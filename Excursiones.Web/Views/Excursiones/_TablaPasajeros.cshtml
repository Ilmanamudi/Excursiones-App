@model IEnumerable<Excursiones.Data.Modelos.Reserva>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning mb-0 py-2 text-center" role="alert">
        <small>Aún no hay reservas registradas para esta excursión.</small>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Pasajero</th>
                    <th>Email</th>
                    <th>Lugares</th>
                    <th>Abonado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-bold">@r.Usuario.Nombre</td>
                        <td><a href="mailto:@r.Usuario.Email" class="text-decoration-none">@r.Usuario.Email</a></td>
                        <td><span class="badge bg-info text-dark">@r.CantidadLugares</span></td>
                        <td>$ @r.TotalAbonado.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}