
@model Excursiones.Web.Models.ExcursionVM

<div class="modal fade" id="modalEdit" tabindex="-1" aria-labelledby="modalEditLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white" style="background-color: var(--primary) !important;">
                <h5 class="modal-title" id="modalEditLabel"><i class="bi bi-pencil-square me-2"></i> Editar Excursión</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form asp-controller="Excursiones" asp-action="Edit" method="post" id="formEditExcursion">
               
                <input type="hidden" asp-for="IdExcursion" />

                <div class="modal-body p-4">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NombreExcursion" class="form-label fw-bold">Nombre de la Excursión</label>
                            <input asp-for="NombreExcursion" class="form-control" />
                            <span asp-validation-for="NombreExcursion" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaExcursion" class="form-label fw-bold">Fecha de Salida</label>
                         
                            <input asp-for="FechaExcursion" class="form-control" />
                            <span asp-validation-for="FechaExcursion" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Precio" class="form-label fw-bold">Precio ($)</label>
                         
                            <input asp-for="Precio" type="text" inputmode="decimal" class="form-control" />
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Cupo" class="form-label fw-bold">Cupo</label>
                            <input asp-for="Cupo" class="form-control" />
                            <span asp-validation-for="Cupo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="DuracionDias" class="form-label fw-bold">Duración (Días)</label>
                            <input asp-for="DuracionDias" class="form-control" />
                            <span asp-validation-for="DuracionDias" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdEstado" class="form-label fw-bold">Estado de la Excursión</label>
                        <select asp-for="IdEstado" asp-items="ViewBag.Estados" class="form-select">
                            <option value="">Seleccione un estado...</option>
                        </select>
                        <span asp-validation-for="IdEstado" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-bold">Descripción (Opcional)</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" style="background-color: var(--primary); border: none;">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>