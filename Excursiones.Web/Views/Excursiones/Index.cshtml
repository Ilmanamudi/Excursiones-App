@model IEnumerable<Excursiones.Web.Models.ExcursionVM>

<!-- Alerta de Éxito -->
@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show m-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Alerta de Error -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show m-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid px-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
        <div>
            <h3 class="fw-bold mb-0">Excursiones Programadas</h3>
            <p class="text-muted small">Gestión de excursiones</p>
        </div>
        <button class="btn btn-primary shadow-sm" style="background-color: var(--primary); border: none;" data-bs-toggle="modal" data-bs-target="#viajeModal">
            <i class="bi bi-plus-lg fw-bold me-1"></i> Nueva Excursión
        </button>
    </div>

   
    <div class="card crud-card">
        <div class="table-responsive">
            <table class="table table-custom table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre / Destino</th>
                        <th>Fecha de Salida</th>
                        <th>Precio</th>
                        <th>Cupo</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    
                    @foreach (var excursion in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@excursion.IdExcursion</td>
                            <td><div class="fw-bold">@excursion.NombreExcursion</div></td>
                            <td>@excursion.FechaExcursion.ToString("dd MMM yyyy")</td>
                            <td><div class="fw-bold text-success">$ @excursion.Precio.ToString("N2")</div></td>
                            <td><div class="fw-bold">@excursion.Cupo</div></td>
                            <td>
                                <span class="badge @excursion.ColorEstado px-3 py-2 rounded-pill">@excursion.NombreEstado</span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <!-- Botón Detalles -->
                                    <button type="button" class="btn btn-light btn-action text-info border me-1" title="Detalles"
                                            data-bs-toggle="modal" data-bs-target="#modalDetails"
                                            data-id="@excursion.IdExcursion"
                                            data-nombre="@excursion.NombreExcursion"
                                            data-fecha="@excursion.FechaExcursion.ToString("dd MMM yyyy")"
                                            data-precio="@excursion.Precio.ToString("N2")"
                                            data-cupo="@excursion.Cupo"
                                            data-estado="@excursion.IdEstado"
                                            data-duracion="@excursion.DuracionDias"
                                            data-descripcion="@excursion.Descripcion">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    <!-- Botón Editar -->
                                    <button type="button" class="btn btn-light text-primary border me-1 btn-ajax-modal" 
                                         data-url="@Url.Action("ObtenerModalEditar", "Excursiones", new { id = excursion.IdExcursion })">
                                             <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <!-- Botón Eliminar (Abre el Modal) -->
                                    <button type="button" class="btn btn-light btn-action text-danger border" title="Eliminar"
                                            data-bs-toggle="modal" data-bs-target="#modalDelete"
                                            data-id="@excursion.IdExcursion"
                                            data-nombre="@excursion.NombreExcursion">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div> 

<!-- Inyección de las Vistas Parciales (Modales) -->
<partial name="_ModalCreate"  model="new Excursiones.Web.Models.ExcursionVM()" />
@* <partial name="_ModalEdit" /> *@
<partial name="_ModalDetails" />
<partial name="_ModalDelete" />
<div id="contenedorModales"></div>

@section Scripts {
    
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/excursiones.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            var alerta = document.querySelector('.alert');
            if (alerta) {
               
                setTimeout(function () {
                    var bootstrapAlert = new bootstrap.Alert(alerta);
                    bootstrapAlert.close();
                }, 3500);
            }
        });
    </script>
}