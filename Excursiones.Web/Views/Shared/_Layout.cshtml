<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Viajes y Excursiones</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top mb-4">
        <div class="container-fluid">
            <div class="collapse navbar-collapse" id="navbarColor02">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Próximas Excursiones</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (!User.HasClaim("Accion", "CrearExcursion"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Reservas" asp-action="MisReservas">Mis Reservas</a>
                            </li>
                        }

                        @if (User.HasClaim("Accion", "CrearExcursion"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Excursiones" asp-action="Index">Administrar Excursiones</a>
                            </li>
                        }

                        <li class="nav-item dropdown ms-3">
                            <a class="nav-link dropdown-toggle text-white d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-5 me-1"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
                                <li><span class="dropdown-item-text text-muted small">Conectado con Google</span></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger fw-bold" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                       
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold" asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Google">
                                <i class="bi bi-google me-1"></i> Iniciar Sesión
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="container pb-3">
        @RenderBody()
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
            $(document).ready(function () {
                @if (TempData["Exito"] != null)
                    {
                        <text>
                            Swal.fire({
                                icon: 'success',
                                title: '¡Operación Exitosa!',
                                text: '@Html.Raw(TempData["Exito"])',
                                confirmButtonColor: '#198754'
                            });
                    </text>
                }

                    @if (TempData["Error"] != null)
                    {
                        <text>
                            Swal.fire({
                                icon: 'error',
                                title: 'No se pudo completar',
                                text: '@Html.Raw(TempData["Error"])',
                                confirmButtonColor: '#dc3545'
                            });
                    </text>
                }

                    @if (TempData["Info"] != null)
                    {
                        <text>
                            Swal.fire({
                                icon: 'info',
                                title: 'Información',
                                text: '@Html.Raw(TempData["Info"])',
                                confirmButtonColor: '#0d6efd'
                            });
                    </text>
                }
                    });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>