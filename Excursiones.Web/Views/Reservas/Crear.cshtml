@model Excursiones.Data.Modelos.Excursion

@{
    ViewData["Title"] = "Confirmar Reserva";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 class="fw-bold"><i class="bi bi-check-circle-fill text-success me-2"></i>Confirmación de Reserva</h2>
            <p class="text-muted">Revisa los detalles antes de confirmar tu lugar.</p>
        </div>
    </div>

    <div class="row g-5">
        <!-- Resumen de la Excursión -->
        <div class="col-md-5 col-lg-4 order-md-last">
            <h4 class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-primary">Tu Viaje</span>
            </h4>
            <ul class="list-group mb-3 shadow-sm">
                <li class="list-group-item d-flex justify-content-between lh-sm p-3">
                    <div>
                        <h6 class="my-0 fw-bold">@Model.NombreExcursion</h6>
                        <small class="text-muted"><i class="bi bi-calendar me-1"></i> @Model.FechaExcursion.ToString("dd/MM/yyyy")</small>
                    </div>
                </li>
                <li class="list-group-item d-flex justify-content-between lh-sm p-3 bg-light">
                    <div class="text-success">
                        <h6 class="my-0"><i class="bi bi-people me-1"></i>Cupos disponibles</h6>
                    </div>
                    <span class="text-success fw-bold">@Model.Cupo</span>
                </li>
                <li class="list-group-item d-flex justify-content-between p-3">
                    <span>Total (ARS)</span>
                    <strong>$ @Model.Precio.ToString("N2")</strong>
                </li>
            </ul>
        </div>

       
        <div class="col-md-7 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h4 class="mb-3">Datos del Pasajero</h4>
                    <form asp-action="GuardarReserva" method="post">
                        <input type="hidden" name="IdExcursion" value="@Model.IdExcursion" />

                        <div class="row g-3">
                           
                            <div class="col-sm-6">
                                <label class="form-label">Nombre de la cuenta</label>
                                <input type="text" class="form-control text-muted" value="@User.Identity.Name" readonly>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">Correo electrónico</label>
                                <input type="email" class="form-control text-muted" value="@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value" readonly>
                            </div>

                            <div class="col-12 mt-4">
                                <label class="form-label fw-bold">Cantidad de lugares a reservar</label>
                                <input type="number" name="CantidadLugares" class="form-control" value="1" min="1" max="@Model.Cupo" required>
                            </div>
                        </div>

                        <hr class="my-4">

                        <button class="w-100 btn btn-primary btn-lg fw-bold" type="submit">
                            <i class="bi bi-cart-check me-2"></i>Confirmar y Finalizar Reserva
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>