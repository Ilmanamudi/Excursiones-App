@model IEnumerable<Excursiones.Data.Modelos.Reserva>
@inject Excursiones.Data.Repositorios.ICalificacionRepository CalificacionRepo

@{
    ViewData["Title"] = "Mis Reservas";
}

<div class="container py-5">

    <!-- ENCABEZADO -->
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 class="fw-bold">
                <i class="bi bi-ticket-perforated-fill text-primary me-2"></i>
                Mis Reservas
            </h2>

            <p class="text-muted">
                Aquí puedes ver el historial de todas las excursiones que has contratado.
            </p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- SIN RESERVAS -->
        <div class="alert alert-info text-center py-4 shadow-sm" role="alert">

            <h4 class="alert-heading fw-bold">
                Aún no tienes reservas
            </h4>

            <p class="mb-3">
                Explora nuestras salidas disponibles y asegura tu lugar en tu próxima aventura.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary fw-bold">
                Ver Excursiones
            </a>

        </div>
    }
    else
    {
        <!-- LISTADO DE RESERVAS -->
        <div class="row row-cols-1 row-cols-md-2 g-4">

          
            @foreach (var reserva in Model)
            {
                var excursionCanceladaPorAdmin = reserva.Excursion.IdEstado == 3 || reserva.Excursion.Borrado;
                var horasRestantes = (reserva.Excursion.FechaExcursion - DateTime.Now).TotalHours;
                var esCancelable = !excursionCanceladaPorAdmin
                                   && reserva.Excursion.IdEstado == 1
                                   && horasRestantes >= 48;

                <div class="col">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                @if (excursionCanceladaPorAdmin)
                                {
                                    <span class="badge bg-danger">Cancelada por la Administración</span>
                                }
                                else if (reserva.Excursion.IdEstado == 2)
                                {
                                    <span class="badge bg-warning">Completada</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Confirmada</span>
                                }

                                <small class="text-muted">
                                    Reservado el: @reserva.FechaReserva.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            <h4 class="card-title fw-bold text-primary">
                                @reserva.Excursion.NombreExcursion
                            </h4>

                            <p class="card-text text-muted small flex-grow-1">
                                @reserva.Excursion.Descripcion
                            </p>

                            <hr />

                            <ul class="list-unstyled mb-3">
                                <li>
                                    <i class="bi bi-calendar-event me-2 text-secondary"></i>
                                    <strong>Fecha de Salida:</strong>
                                    @reserva.Excursion.FechaExcursion.ToString("dd/MM/yyyy")
                                </li>
                                <li>
                                    <i class="bi bi-people me-2 text-secondary"></i>
                                    <strong>Lugares reservados:</strong>
                                    @reserva.CantidadLugares
                                </li>
                                <li>
                                    <i class="bi bi-cash-stack me-2 text-secondary"></i>
                                    <strong>Total Abonado:</strong>
                                    $ @reserva.TotalAbonado.ToString("N2")
                                </li>
                            </ul>

                            <hr />

                            @if (excursionCanceladaPorAdmin)
                            {
                                <div class="alert alert-danger text-center p-2 mb-2 small shadow-sm">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    Esta excursión fue suspendida por la administración.
                                    Puedes quitarla de tu historial.
                                </div>

                                <div class="mt-auto">
                                    <form asp-controller="Reservas"
                                          asp-action="Cancelar"
                                          method="post"
                                          class="form-cancelar w-100">

                                        <input type="hidden" name="idReserva" value="@reserva.IdReserva" />

                                        <button type="button" class="btn btn-outline-danger btn-sm w-100 fw-bold btn-cancelar">
                                            <i class="bi bi-trash me-1"></i>
                                            Quitar de Mis Reservas
                                        </button>
                                    </form>
                                </div>
                            }
                            else if (esCancelable)
                            {
                                <div class="d-flex gap-2 mt-auto">

                                    <a asp-controller="Reservas"
                                       asp-action="Editar"
                                       asp-route-idReserva="@reserva.IdReserva"
                                       class="btn btn-outline-primary btn-sm w-50 fw-bold">
                                        <i class="bi bi-pencil-square me-1"></i>
                                        Modificar Lugares
                                    </a>

                                    <form asp-controller="Reservas"
                                          asp-action="Cancelar"
                                          method="post"
                                          class="form-cancelar w-50">

                                        <input type="hidden" name="idReserva" value="@reserva.IdReserva" />

                                        <button type="button" class="btn btn-outline-danger btn-sm w-100 fw-bold btn-cancelar">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Cancelar
                                        </button>
                                    </form>

                                </div>
                            }
                            else
                            {
                                @if (reserva.Excursion.IdEstado == 2)
                                {
                                    bool yaCalifico = CalificacionRepo.ExisteCalificacion(reserva.IdReserva);

                                    @if (!yaCalifico)
                                    {
                                        <div class="mt-3">
                                            <a asp-controller="Reservas"
                                               asp-action="Calificar"
                                               asp-route-idReserva="@reserva.IdReserva"
                                               class="btn btn-warning btn-sm w-100 fw-bold shadow-sm">
                                                <i class="bi bi-star-fill me-1"></i>
                                                Calificar Excursión
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-success text-center p-2 mb-0 mt-3 small">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            ¡Gracias por tu calificación!
                                        </div>
                                    }
                                }
                                else if (reserva.Excursion.IdEstado == 1)
                                {
                                    <div class="alert alert-warning text-center p-2 mb-0 mt-3 small">
                                        <i class="bi bi-clock-history me-1"></i>
                                        Ya no es posible modificar ni cancelar (menos de 48 hs para la salida).
                                    </div>
                                }
                            }

                        </div>
                    </div>
                </div>
            }


        </div>
    }

</div>

@section Scripts {

    <script>
        $(document).ready(function () {

            $('.btn-cancelar').on('click', function (e) {

                e.preventDefault();

                var form = $(this).closest('form');

                Swal.fire({
                    title: '¿Estás seguro?',
                    text: "Esta acción quitará el registro de tu historial.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, confirmar',
                    cancelButtonText: 'Volver'
                }).then((result) => {

                    if (result.isConfirmed) {
                        form.submit();
                    }

                });

            });

        });
    </script>

}
