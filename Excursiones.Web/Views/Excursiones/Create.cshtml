@{
}

@{
    string resultadomsj = ViewBag.Mensaje.ToString();


 }



@model ExcursionVM
<form asp-action="Create">

    <label asp-for="NombreExcursion"></label>
    <input asp-for="NombreExcursion" />
    <span asp-validation-for="NombreExcursion" style="font-color:red"></span>
    <br />
    <label asp-for="FechaExcursion"></label>
    <input asp-for="FechaExcursion" />
    <span asp-validation-for="FechaExcursion"></span>
    <br />
   
    <br />
    <input type="submit" value="enviar informacion" />

    <br />

    
   @{ 
       if (!String.IsNullOrEmpty(resultadomsj))
        {
            <span>@(resultadomsj)</span>
        }
    }
</form>
